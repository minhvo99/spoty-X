{
  "name": "spoty-x",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.16",
    "expo": "~58.0.22",
    "expo-auth-session": "~58.0.16",
    "expo-crypto": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web && node scripts/post-export.mjs",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "build:native:check": "expo export --platform ios --platform android --output-dir dist-native"
  },
  "private": true,
  "type": "module",
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  }
}

{
  "expo": {
    "name": "Spoty-X",
    "slug": "spoty-x",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.minhvo99.spotyx"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080a09",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.minhvo99.spotyx"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Spoty-X",
      "shortName": "Spoty-X",
      "description": "M\u1edf Spoty-X v\u00e0 nghe ngay. Nh\u1ea1c m\u1edf, nh\u1ea1c c\u1ee7a b\u1ea1n, kh\u00f4ng qu\u1ea3ng c\u00e1o v\u00e0 kh\u00f4ng c\u1ea7n API key."
    },
    "plugins": [
      "expo-image",
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "scheme": "spotyx",
    "experiments": {
      "baseUrl": "/spoty-X"
    }
  }
}
